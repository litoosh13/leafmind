         has_covering_image,
@@ -2251,7 +2274,7 @@ pub(crate) fn page_ocr_signals(doc: &Document, page_id: ObjectId) -> PageOcrSign
         let insufficient_text =
             analysis.text_operator_count < DetectionConfig::default().min_text_ops_per_page.max(10);
