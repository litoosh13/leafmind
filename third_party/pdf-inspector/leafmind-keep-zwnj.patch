+/// Scripts whose spelling uses ZWNJ/ZWJ inside words (Arabic script incl. Persian/Urdu, Indic scripts).
+fn uses_joiners(c: char) -> bool {
+    matches!(c, '\u{0600}'..='\u{06FF}' | '\u{0750}'..='\u{077F}' | '\u{08A0}'..='\u{08FF}'
+        | '\u{FB50}'..='\u{FDFF}' | '\u{FE70}'..='\u{FEFF}' | '\u{0900}'..='\u{0DFF}')
+}
+
+/// A joiner between two letters where at least one belongs to such a script is part of the word.
+fn joiner_is_orthographic(chars: &[char], i: usize) -> bool {
+    let prev = chars[..i].iter().rev().find(|c| !matches!(c, '\u{200C}' | '\u{200D}'));
+    let next = chars[i + 1..].iter().find(|c| !matches!(c, '\u{200C}' | '\u{200D}'));
+    match (prev, next) {
+        (Some(&p), Some(&n)) => p.is_alphabetic() && n.is_alphabetic() && (uses_joiners(p) || uses_joiners(n)),
+        _ => false,
+    }
+}
+
+/// Remove ZWNJ/ZWJ that ended up anywhere other than inside a word of a script that uses them.
+pub(crate) fn strip_stray_joiners(text: &str) -> String {
+    if !text.contains(['\u{200C}', '\u{200D}']) {
+        return text.to_string();
+    }
+    let chars: Vec<char> = text.chars().collect();
+    chars
+        .iter()
+        .enumerate()
+        .filter(|&(i, c)| !matches!(c, '\u{200C}' | '\u{200D}') || joiner_is_orthographic(&chars, i))
+        .map(|(_, c)| *c)
+        .collect()
+}
